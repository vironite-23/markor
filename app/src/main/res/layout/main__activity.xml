<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    android:theme="@style/AppTheme.Unified"
    tools:context="net.gsantner.markor.activity.MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:theme="@style/AppTheme.Light.AppBarOverlay">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            android:theme="@style/LightTextToolbarOverlay"
            app:subtitleTextColor="@color/dark__secondary_text"
            app:title="@string/app_name">

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/main__view_pager_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:layout_marginBottom="?attr/actionBarSize" />

    <!--
    Shown instead of the Notebook tab's content when the configured Notebook root folder no
    longer exists or its access permission was revoked - see
    MainActivity#updateNotebookFolderAvailability(). Covers the same area as the ViewPager so it
    fully replaces the (otherwise just empty-looking) file list with a clear explanation + a way
    to pick a new folder, rather than the Notebook tab silently doing nothing or falling back to
    browsing anywhere else on the device.
    -->
    <LinearLayout
        android:id="@+id/main__notebook_folder_unavailable"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:layout_marginBottom="?attr/actionBarSize"
        android:background="@color/background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/main__notebook_folder_unavailable_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="@string/notebook_folder_unavailable_title"
            android:textColor="@color/primary_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/main__notebook_folder_unavailable_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="@string/notebook_folder_unavailable_description"
            android:textColor="@color/secondary_text" />

        <Button
            android:id="@+id/main__notebook_folder_unavailable_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_notebook_folder" />

    </LinearLayout>

    <!--suppress AndroidUnknownAttribute -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_new_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="72dp"
        android:contentDescription="@string/create_new_file_or_folder"
        android:src="@drawable/ic_add_white_24dp"
        app:shapeAppearance="@style/ShapeAppearanceOverlay.Material3.FloatingActionButton" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_gravity="start|bottom"
        android:background="@color/primary"
        app:itemBackground="@color/primary"
        app:itemIconTint="@drawable/bottomnav_color_selector"
        app:itemTextColor="@drawable/bottomnav_color_selector"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/main__bottom_nav" />

</FrameLayout>
