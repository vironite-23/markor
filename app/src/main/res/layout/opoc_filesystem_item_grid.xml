<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/opoc_filesystem_item__root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <!-- Actual pixel size is set at bind time from the grid cover width/height settings, so
         the container is one consistent, user-resizable rectangle whether or not the item
         has a cover image. Rounded corners + selection highlight are applied at runtime too
         (ViewOutlineProvider / background), since they depend on theme + selection state. -->
    <FrameLayout
        android:id="@+id/opoc_filesystem_item__image_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/grid_item_bg_normal">

        <ImageView
            android:id="@+id/opoc_filesystem_item__image"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            tools:ignore="ContentDescription"
            tools:src="@android:drawable/btn_radio" />
    </FrameLayout>

    <TextView
        android:id="@+id/opoc_filesystem_item__title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="10dp"
        android:ellipsize="end"
        android:gravity="center_horizontal|top"
        android:importantForAccessibility="no"
        android:maxLines="3"
        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
        android:textAlignment="center"
        android:textSize="13sp"
        tools:text="how to write a really quite long readme.md" />

    <!-- Kept but hidden in grid mode: FilesystemViewerViewHolder binds to this
         id unconditionally, so it must exist to avoid a NullPointerException. -->
    <TextView
        android:id="@+id/opoc_filesystem_item__description"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:visibility="gone"
        tools:ignore="ContentDescription" />

</LinearLayout>
