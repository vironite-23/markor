<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/document__sidepanel_text_viewer__root"
    android:layout_width="400dp"
    android:layout_height="match_parent"
    android:layout_gravity="end"
    android:background="@color/background"
    android:elevation="8dp"
    android:orientation="vertical">

    <!-- Top bar: close / change text / search -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/document__sidepanel_text_viewer__close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:padding="12dp"
            android:src="@drawable/baseline_close_24"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/document__sidepanel_text_viewer__title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="@color/white" />

        <ImageButton
            android:id="@+id/document__sidepanel_text_viewer__change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/select_text"
            android:padding="12dp"
            android:src="@drawable/ic_insert_drive_file_black_24dp"
            app:tint="@color/white" />

        <ImageButton
            android:id="@+id/document__sidepanel_text_viewer__search_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search"
            android:padding="12dp"
            android:src="@drawable/ic_search_black_24dp"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- Inline search bar, hidden by default -->
    <LinearLayout
        android:id="@+id/document__sidepanel_text_viewer__search_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:orientation="horizontal"
        android:padding="4dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/document__sidepanel_text_viewer__search_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/search"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:singleLine="true" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/document__sidepanel_text_viewer__scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <TextView
            android:id="@+id/document__sidepanel_text_viewer__text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textIsSelectable="true"
            android:textSize="14sp" />
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
